# Application
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/duka_yetu
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Codespaces frontend origins are also allowed via allow_origin_regex in app/main.py
LOW_STOCK_THRESHOLD=10

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=duka_yetu

# Stripe subscriptions (use a restricted key where your account supports it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_MONTHLY_PRICE_ID=
STRIPE_BASIC_YEARLY_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=

# Public API URL Safaricom can reach (ngrok/cloud). Required for platform STK callbacks
# (subscriptions and featured products only). Seller Paybill/Till/Send Money does not use this.
API_BASE_URL=http://localhost:8001
MPESA_CALLBACK_BASE_URL=

# Platform Daraja only. Sellers never enter these. Used when a shop pays YOU
# for a subscription or to feature a product. Sandbox shortcode 174379 is Safaricom's test paybill.
# Safaricom Daraja (sandbox first; switch MPESA_ENVIRONMENT=production later)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379

# KopoKopo sandbox STK (customer checkout). Create the app at https://sandbox.kopokopo.com
# Till is the online payments account in Outlets (often starts with K). Leave secrets out of git.
KOPOKOPO_ENVIRONMENT=sandbox
KOPOKOPO_BASE_URL=https://sandbox.kopokopo.com
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_API_KEY=
KOPOKOPO_TILL_NUMBER=
# Public https URL of this API. Sandbox results are also polled, so this can stay empty locally.
KOPOKOPO_CALLBACK_BASE_URL=

# Super admin bootstrap (set a strong password before first run)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=superadmin@dukayetu.local

# Marketplace commission (%)
MARKETPLACE_COMMISSION_PERCENT=5

# Fee sellers pay (M-Pesa to platform) to feature a product on the store hero
FEATURE_PRODUCT_FEE_KES=500
FEATURE_PRODUCT_DAYS=7

# Forgot-password and other emails. Create a key at https://resend.com/api-keys.
# RESEND_FROM_EMAIL must use a domain you verified in Resend.
# onboarding@resend.dev only delivers to the email on your Resend account.
# FRONTEND_URL (above) is the link in the reset email, so set it to your live site.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Duka Yetu <onboarding@resend.dev>
PLATFORM_NOTIFY_EMAIL=

# Platform subscription prices (KES) — owners pay these via M-Pesa to your shortcode
PLAN_BASIC_MONTHLY_KES=1000
PLAN_BASIC_YEARLY_KES=10000
PLAN_PROFESSIONAL_MONTHLY_KES=1700
PLAN_PROFESSIONAL_YEARLY_KES=17000
PLAN_ENTERPRISE_MONTHLY_KES=2500
PLAN_ENTERPRISE_YEARLY_KES=25000
